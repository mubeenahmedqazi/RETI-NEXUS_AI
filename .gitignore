# Python virtual environments (Root & Subdirectories)
**/.venv*/
.venv/
venv/
ENV/
env/

# Python caching & compiled binaries
__pycache__/
backend/src/__pycache__/
*.pyc
*.pyd
*.so
*.dll

# Ignore deep learning weights and models
backend/trained_weights/
*.pth
*.pt
*.h5
*.onnx

# Vector / Database storage & local indexes
chromadb/
lancedb/
*.db
*.sqlite3

# Ignore output images and visualizations (scoped to the backend so app
# public/ folders — admin & portal logos etc. — aren't caught by a blanket rule)
backend/output_results/
retinexus_backend/**/*.png
retinexus_backend/**/*.jpg
retinexus_backend/**/*.jpeg

# Node / Next.js
node_modules/
.next/
out/
build/
*.tsbuildinfo
next-env.d.ts

# Env files
.env
.env.local
.env*.local

# Firebase Admin service-account keys — grant full admin access to a Firebase project,
# never commit these. Root-level so it's caught no matter which app folder it ends up
# in, in addition to any app-specific .gitignore rule.
firebase-service-account.json
*firebase-adminsdk*.json
serviceAccountKey.json

# RetiNexus AI chat widget knowledge base — PDFs and the generated embedding
# index are user-supplied and can be large; keep the folder structure only.
retinexus_website/knowledge/pdfs/*.pdf
retinexus_website/data/eye-knowledge-index.json

# Prisma schema & sensitive config files
schema.prisma
**/prisma/schema.prisma