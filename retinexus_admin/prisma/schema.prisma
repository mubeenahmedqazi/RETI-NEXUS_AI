generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  password       String?
  name           String
  role           Role         @default(DOCTOR)
  hospital       String?
  phone          String?
  specialization String?
  isActive       Boolean      @default(true)
  status         DoctorStatus @default(APPROVED)
  firebaseUid    String?      @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  patients          Patient[]          @relation("DoctorPatient")
  reports           Report[]           @relation("DoctorReports")
  detailedAnalyses  DetailedAnalysis[] @relation("DoctorDetailedAnalyses")

  @@map("users")
}

model Patient {
  id            String   @id @default(cuid())
  name          String
  phone         String
  age           Int?
  gender        String?
  address       String?
  password      String?  // For patient login
  doctorId      String?  //  Optional - can be null for self-registered
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  doctor            User?              @relation("DoctorPatient", fields: [doctorId], references: [id])
  reports           Report[]           @relation("PatientReports")
  detailedAnalyses  DetailedAnalysis[] @relation("PatientDetailedAnalyses")

  @@map("patients")
}

model Report {
  id            String   @id @default(cuid())
  reportNumber  Int      @unique @default(autoincrement())
  // Human-facing report code — SR + YYMMDD + a 2-digit daily sequence shared across all
  // doctors (e.g. "SR26090401"), assigned once at creation and never recomputed —
  // displayed identically everywhere (lists, detail pages, PDFs, admin) instead of each
  // surface deriving its own ad-hoc label from reportNumber/id. Nullable only so existing
  // rows created before this field existed don't break; a backfill script fills those in.
  reportCode    String?  @unique
  patientId     String
  patientName   String
  doctorId      String
  drGrade       String
  confidence    Float
  description   String
  imageUrl      String
  imagePublicId String?
  processedAt   String
  reportData    Json
  clinicalReport String?
  approved      Boolean  @default(true)
  approvedAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  patient       Patient  @relation("PatientReports", fields: [patientId], references: [id])
  doctor        User     @relation("DoctorReports", fields: [doctorId], references: [id])
  detailedAnalyses DetailedAnalysis[] @relation("ReportDetailedAnalyses")

  @@map("reports")
}

// A saved Detailed Analysis: a follow-up test (e.g. Lipid Profile, ECG) uploaded by the
// doctor, OCR'd, and correlated by the LLM against the patient's screening report + recent
// visit history. Linked back to the screening Report it was run against where available.
model DetailedAnalysis {
  id               String   @id @default(cuid())
  patientId        String
  doctorId         String
  reportId         String?
  // Human-facing report code — DA + YYMMDD + a 2-digit daily sequence shared across all
  // doctors (e.g. "DA26090401"). Named differently from `reportId` above on purpose:
  // that field is the FK to the linked screening Report, an unrelated concept.
  reportCode       String?  @unique
  testName         String
  clinicalSummary  String
  testFindings     String
  organFindings    Json
  redFlags         String[]
  recommendations  String[]
  urgency          String
  extractionMethod String?
  createdAt        DateTime @default(now())

  patient          Patient  @relation("PatientDetailedAnalyses", fields: [patientId], references: [id])
  doctor           User     @relation("DoctorDetailedAnalyses", fields: [doctorId], references: [id])
  report           Report?  @relation("ReportDetailedAnalyses", fields: [reportId], references: [id])

  @@map("detailed_analyses")
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}

enum Role {
  DOCTOR
  PATIENT
}

enum DoctorStatus {
  PENDING
  APPROVED
  BLOCKED
}
